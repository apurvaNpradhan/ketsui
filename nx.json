{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "useInferencePlugins": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.test.tsx",
      "!{projectRoot}/e2e/**/*",
      "!{projectRoot}/**/node_modules/**"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/.oxlintrc.json",
      "{workspaceRoot}/.oxfmtrc.json"
    ]
  },
  "tui": {
    "enabled": true
  },
  "targetDefaults": {
    "build": {
      "inputs": ["production", "^production"],
      "cache": true
    },
    "typecheck": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "format:check": {
      "inputs": ["default"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "continuous": true,
      "options": {
        "color": true
      }
    },
    "preview": {
      "cache": false,
      "continuous": true
    },
    "start": {
      "cache": false,
      "continuous": true
    },
    "e2e": {
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "generate": {
      "cache": false
    },
    "api:generate": {
      "cache": false
    },
    "db": {
      "cache": false
    },
    "auth:generate": {
      "cache": false
    },
    "ui": {
      "cache": false
    }
  },
  "analytics": false
}
