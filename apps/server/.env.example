# FastAPI server settings
FASTAPI_ENV=development
PROJECT_NAME=Ketsui
FRONTEND_HOST=http://localhost:5173

# Backend database only. Keep the password URL-safe or URL-encode it.
DATABASE_URL=postgresql://backend_app:change-this-backend-password@localhost:5432/backend_db

# Better Auth JWT verification. The server reads JWKS; it never queries auth_db.
BETTER_AUTH_JWKS_URL=http://localhost:5173/api/auth/jwks
BETTER_AUTH_URL=http://localhost:5173
