{
  "name": "@repo/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env ./node_modules/vite/bin/vite.js dev",
    "preview": "node --env-file-if-exists=../../.env ./node_modules/vite/bin/vite.js preview",
    "start": "node --env-file-if-exists=../../.env --input-type=module -e \"process.env.NITRO_PORT = process.env.PORT || process.env.FRONTEND_PORT; await import('./.output/server/index.mjs')\"",
    "api:generate": "node --env-file-if-exists=../../.env --input-type=module -e \"if (!process.env.BACKEND_PORT) throw new Error('BACKEND_PORT must be set'); import { execFileSync } from 'node:child_process'; execFileSync('openapi-typescript', ['http://localhost:' + process.env.BACKEND_PORT + '/openapi.json', '-o', 'src/lib/api/schema.d.ts'], { stdio: 'inherit' })\"",
    "ui": "pnpm dlx shadcn@latest"
  },
  "dependencies": {
    "@ag-ui/client": "catalog:",
    "@assistant-ui/react": "catalog:",
    "@assistant-ui/react-ag-ui": "catalog:",
    "@assistant-ui/react-markdown": "catalog:",
    "@assistant-ui/react-streamdown": "catalog:",
    "@base-ui/react": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/ui": "workspace:*",
    "@streamdown/cjk": "catalog:",
    "@streamdown/code": "catalog:",
    "@streamdown/math": "catalog:",
    "@streamdown/mermaid": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "catalog:",
    "drizzle-orm": "catalog:",
    "lucide-react": "catalog:",
    "openapi-fetch": "catalog:",
    "openapi-react-query": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "streamdown": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@repo/tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/devtools-a11y": "catalog:",
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-form-devtools": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "cross-env": "catalog:",
    "nitro": "catalog:",
    "openapi-typescript": "catalog:",
    "oxc-transform-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
