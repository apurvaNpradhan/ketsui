{
  "name": "@repo/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env ../../node_modules/vite-plus/bin/vp dev",
    "preview": "node --env-file-if-exists=../../.env ../../node_modules/vite-plus/bin/vp preview",
    "start": "node --env-file-if-exists=../../.env --input-type=module -e \"process.env.NITRO_PORT = process.env.PORT || process.env.FRONTEND_PORT; await import('./.output/server/index.mjs')\"",
    "start:e2e": "node --env-file-if-exists=../../.env --input-type=module -e \"process.env.NITRO_PORT = process.env.PORT || process.env.FRONTEND_PORT; await import('./.output/server/index.mjs')\"",
    "api:generate": "node --env-file-if-exists=../../.env --input-type=module -e \"if (!process.env.BACKEND_PORT) throw new Error('BACKEND_PORT must be set'); import { execFileSync } from 'node:child_process'; execFileSync('openapi-typescript', ['http://localhost:' + process.env.BACKEND_PORT + '/openapi.json', '-o', 'src/lib/api/schema.d.ts'], { stdio: 'inherit' })\"",
    "test:e2e": "playwright test --pass-with-no-tests",
    "ui": "vpx shadcn@latest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@icons-pack/react-simple-icons": "catalog:",
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tanstack/router-core": "catalog:",
    "date-fns": "catalog:",
    "drizzle-orm": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "nanoid": "catalog:",
    "openapi-fetch": "catalog:",
    "openapi-react-query": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@repo/tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/devtools-a11y": "catalog:",
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-form-devtools": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "cross-env": "catalog:",
    "nitro": "catalog:",
    "openapi-typescript": "catalog:",
    "oxc-transform-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "5.9.3",
    "vite": "catalog:"
  }
}
