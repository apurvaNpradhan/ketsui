# Compose/bootstrap settings. Keep database passwords URL-safe or URL-encode them.
POSTGRES_PASSWORD=change-this-postgres-password
BACKEND_DB_PASSWORD=change-this-backend-password
AUTH_DB_PASSWORD=change-this-auth-password

# Public web origin used by Better Auth
VITE_BASE_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=change-this-auth-secret

# Optional OAuth providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
