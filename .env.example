# Copy this file to .env. It is used for both host development and Docker Compose.
# Compose derives container-only URLs in compose.yml, so no second env file is needed.
# These values are for local development only. Use real secrets in deployments.

# ============================================================
# 🔗 Shared
# ============================================================

# Public web origin used by Better Auth and FastAPI CORS.
VITE_BASE_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-at-least-32-characters

# OAuth providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# 🌍 Web
# ============================================================

# Host connection URL used by Better Auth/Drizzle.
# Keep its password in sync with AUTH_DB_PASSWORD below.
AUTH_DATABASE_URL=postgresql://auth_app:replace-with-a-local-auth-password@localhost:5432/auth_db
# Port used by the web app in local development and Compose.
FRONTEND_PORT=5173
# Server-only origin used by the TanStack Start API proxy.
FASTAPI_ORIGIN=http://localhost:8000

# ============================================================
# 🖥️ Server
# ============================================================

FASTAPI_ENV=development
PROJECT_NAME=Ketsui
# Port used by FastAPI in local development and Compose.
BACKEND_PORT=8000
FRONTEND_HOST=http://localhost:5173
# Host connection URL used by FastAPI/SQLAlchemy.
# Keep its password in sync with BACKEND_DB_PASSWORD below.
DATABASE_URL=postgresql://backend_app:replace-with-a-local-backend-password@localhost:5432/backend_db
BETTER_AUTH_JWKS_URL=http://localhost:5173/api/auth/jwks

# ============================================================
# 🐘 PostgreSQL (used by Docker Compose)
# ============================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
BACKEND_DB_PASSWORD=replace-with-a-local-backend-password
AUTH_DB_PASSWORD=replace-with-a-local-auth-password
