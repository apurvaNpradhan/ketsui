# ============================================================
# 🔗 Shared
# ============================================================

# Public web origin used by Better Auth and FastAPI CORS.
VITE_BASE_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-at-least-32-characters

# OAuth providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# 🌍 Web
# ============================================================

# Auth database used by Better Auth/Drizzle.
AUTH_DATABASE_URL=postgresql://auth_app:change-this-auth-password@localhost:5432/auth_db
# Server-only origin used by the TanStack Start API proxy.
FASTAPI_ORIGIN=http://localhost:8000

# ============================================================
# 🖥️ Server
# ============================================================

FASTAPI_ENV=development
PROJECT_NAME=Ketsui
FRONTEND_HOST=http://localhost:5173
# Backend database used by FastAPI/SQLModel.
BACKEND_DATABASE_URL=postgresql://backend_app:change-this-backend-password@localhost:5432/backend_db
BETTER_AUTH_JWKS_URL=http://localhost:5173/api/auth/jwks
